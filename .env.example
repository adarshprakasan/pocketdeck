# Set these in production when the WebSocket signaling service is hosted separately.
NEXT_PUBLIC_SIGNALING_URL=wss://signal.example.com
ALLOWED_ORIGIN=https://pocketdeck.example.com

# Optional local override when the computer has multiple network adapters.
# Use the computer's private Wi-Fi/LAN IPv4 address.
# POCKETDECK_LAN_ADDRESS=192.168.1.20
