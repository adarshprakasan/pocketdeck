# Optional TURN relay for networks that block direct browser connections.
# Configure a TURN service using the coturn REST API shared-secret method.
# Credentials are generated per approved pairing and expire after four hours.
# Keep these credentials private. Do not add them to NEXT_PUBLIC_ variables.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SHARED_SECRET=replace-with-your-turn-rest-shared-secret

# Alternatively, use Cloudflare Realtime TURN. Create a TURN key, then set its
# ID and secret here. Credentials are issued for each approved pairing.
# CLOUDFLARE_TURN_KEY_ID=your-turn-key-uid
# CLOUDFLARE_TURN_KEY_SECRET=your-turn-key-secret

# Optional local override when the computer has multiple network adapters.
# Use the computer's private Wi-Fi/LAN IPv4 address.
# POCKETDECK_LAN_ADDRESS=192.168.1.20
