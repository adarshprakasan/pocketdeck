# Optional Cloudflare Realtime TURN credentials for networks that block direct
# browser traffic. Keep your credentials private.
# CLOUDFLARE_TURN_KEY_ID=your-turn-key-id
# CLOUDFLARE_TURN_KEY_SECRET=your-turn-key-secret

# Or configure a coturn REST service instead.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SHARED_SECRET=your-turn-rest-shared-secret

# Optional override if the computer has multiple network adapters.
# POCKETDECK_LAN_ADDRESS=192.168.1.20
